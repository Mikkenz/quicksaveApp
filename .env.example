# Copie este arquivo para .env.local e preencha. O .env.local não vai para o git.
# Estes valores são públicos por natureza (ficam dentro do app). Nunca coloque aqui a chave secreta (service_role).

# Supabase > Project Settings > API (ou Data API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth do tipo "Aplicativo da Web"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
