{
  "expo": {
    "name": "Quicksave",
    "slug": "quicksave-app",
    "scheme": "quicksave",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "br.com.quicksavegames.app",
      "adaptiveIcon": {
        "backgroundColor": "#8d3da4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8d3da4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.ios-nao-usado"
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7f2390a0-2064-4dd7-8988-96593d2ba78a"
      }
    },
    "owner": "mikken"
  }
}
